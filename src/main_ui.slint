import { ScrollView, VerticalBox, HorizontalBox, LineEdit, Button } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Vuzt Engine";
    background: #FFFFFF;
    // Window di Android otomatis full screen, tidak perlu 100%

    in-out property <string> result-text: "0";
    callback process-logic(string);

    VerticalBox {
        padding: 0;
        spacing: 0;

        // --- DARK STATUS BAR AREA ---
        Rectangle {
            height: 40px;
            background: #000000;
            Text {
                text: "VUZT SYSTEM ACTIVE";
                color: #00FF00;
                font-size: 10px;
                font-family: "monospace";
                horizontal-alignment: center;
            }
        }

        // --- HEADER ---
        Rectangle {
            height: 100px;
            background: #FFFFFF;
            Text {
                x: 25px; y: 40px;
                text: "Rust Processor";
                font-size: 28px;
                font-weight: 900;
                color: #1C1C1E;
            }
        }

        VerticalBox {
            padding: 25px;
            spacing: 20px;

            Text { text: "Input Formula:"; color: #8E8E93; font-weight: 600; }
            
            input_box := LineEdit {
                font-size: 20px;
                placeholder-text: "Contoh: 150 + 25 * 4";
                height: 60px;
                edited => { root.process-logic(self.text) }
            }

            Rectangle {
                height: 150px;
                background: #1C1C1E;
                border-radius: 24px;
                
                VerticalBox {
                    padding: 25px;
                    alignment: center;
                    Text { 
                        text: "RESULT"; 
                        color: #8E8E93; 
                        font-size: 12px; 
                        font-weight: 800;
                        horizontal-alignment: center;
                    }
                    Text { 
                        text: root.result-text; 
                        color: #00FF00; 
                        font-size: 45px; 
                        font-weight: 900;
                        horizontal-alignment: center;
                    }
                }
            }

            Button {
                text: "CLEAR";
                clicked => { 
                    input_box.text = "";
                    root.result-text = "0";
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
    }
}
