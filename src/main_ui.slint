import { VerticalBox, LineEdit } from "std-widgets.slint";

export component AppWindow inherits Window {
    // Properti ini adalah 'Pintu' untuk Rust
    in-out property <string> engine-type: "Native Rust (No JVM)";
    in-out property <string> render-mode: "GPU Accelerated";
    in-out property <string> calc-result: "0";
    in-out property <color> status-color: #00FF00;

    background: #1C1C1E;

    VerticalBox {
        padding: 20px;
        spacing: 15px;

        // Header Bukti
        Text {
            text: "SYSTEM DATA";
            color: #8E8E93;
            font-size: 14px;
            font-weight: 800;
        }

        // Card Info
        Rectangle {
            background: #2C2C2E;
            border-radius: 12px;
            height: 100px;
            VerticalBox {
                alignment: center;
                Text { text: "Engine: " + root.engine-type; color: white; }
                Text { text: "Render: " + root.render-mode; color: root.status-color; }
            }
        }

        // Area Kerja (JS-like Logic in Rust)
        Text { text: "Logic Processor:"; color: #8E8E93; }
        input := LineEdit {
            placeholder-text: "Ketik angka (misal: 2+2)";
            height: 50px;
            edited => { root.calculate(self.text) }
        }

        Rectangle {
            height: 80px;
            background: #00FF0015;
            border-radius: 12px;
            border-width: 1px;
            border-color: #00FF00;
            Text {
                text: root.calc-result;
                font-size: 30px;
                color: #00FF00;
                horizontal-alignment: center;
            }
        }
    }

    callback calculate(string);
}
